# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's gitignored.

# Supabase
# Public anon key + URL are safe to ship in the client bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Service-role key. Backend / Edge Function ONLY — never the RN bundle.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used by the Edge Function and the dev scripts under server/.
# In production the key lives as a Supabase secret, NOT in this file.
OPENAI_API_KEY=

# Sentry crash reporting. The DSN is a public ingest endpoint — safe to
# ship in the client bundle (that's why it's EXPO_PUBLIC_*). When unset,
# Sentry init is skipped silently and the app still runs.
EXPO_PUBLIC_SENTRY_DSN=
